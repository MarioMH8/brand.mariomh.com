{
	"extends": "@hexadrop/tsconfig",
	"compilerOptions": {
		"emitDecoratorMetadata": false,
		"baseUrl": ".",
		"paths": {
			"@mariomh8/storybook/argument-types": ["storybook/src/argument-types"],
			"@mariomh8/storybook/blocks": ["storybook/src/blocks"],
			"@mariomh8/storybook/hooks": ["storybook/src/hooks"],
			"@mariomh8/storybook/pages": ["storybook/src/pages"],
			"@mariomh8/cva": ["packages/cva/src/index.ts"],
			"@mariomh8/badge/react": ["./components/badge/src/react.tsx"],
			"@mariomh8/box/react": ["./components/box/src/react.tsx"],
			"@mariomh8/button/react": ["./components/button/src/react.tsx"],
			"@mariomh8/checkbox/react": ["./components/checkbox/src/react.tsx"],
			"@mariomh8/copyright/react": ["./components/copyright/src/react.tsx"],
			"@mariomh8/container/react": ["./components/container/src/react.tsx"],
			"@mariomh8/container/variants": ["./components/container/src/variants.ts"],
			"@mariomh8/focus/react": ["./components/focus/src/react.tsx"],
			"@mariomh8/focus/variants": ["./components/focus/src/variants.ts"],
			"@mariomh8/font/react": ["./components/font/src/react.tsx"],
			"@mariomh8/font/variants": ["./components/font/src/variants.ts"],
			"@mariomh8/heading/react": ["./components/heading/src/react.tsx"],
			"@mariomh8/input/react": ["./components/input/src/react.tsx"],
			"@mariomh8/label/react": ["./components/label/src/react.tsx"],
			"@mariomh8/link/react": ["./components/link/src/react.tsx"],
			"@mariomh8/logo/react": ["./components/logo/src/react.tsx"],
			"@mariomh8/navigation-menu/react": ["./components/navigation-menu/src/react/index.ts"],
			"@mariomh8/paragraph/react": ["./components/paragraph/src/react.tsx"],
			"@mariomh8/round/react": ["./components/round/src/react.tsx"],
			"@mariomh8/round/variants": ["./components/round/src/variants.ts"],
			"@mariomh8/select/react": ["./components/select/src/react.tsx"],
			"@mariomh8/shadow/react": ["./components/shadow/src/react.tsx"],
			"@mariomh8/span/react": ["./components/span/src/react.tsx"],
			"@mariomh8/tailwind/pallete": ["packages/tailwind/src/pallete.ts"],
			"@mariomh8/textarea/react": ["./components/textarea/src/react.tsx"]
		},
		"allowImportingTsExtensions": true,
		"plugins": [
			{
				"name": "@astrojs/ts-plugin"
			}
		]
	},
	"exclude": [
		"components/*/dist"
	]
}
