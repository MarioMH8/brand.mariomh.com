{
	"extends": "@hexadrop/tsconfig",
	"compilerOptions": {
		"emitDecoratorMetadata": false,
		"baseUrl": ".",
		"paths": {
			"@mariomh/cva": ["packages/cva/src/index.ts"],
			"@mariomh/focus/react": ["./components/focus/src/react.tsx"],
			"@mariomh/font/react": ["./components/font/src/react.tsx"],
			"@mariomh/shadow/react": ["./components/shadow/src/react.tsx"]
		},
		"allowImportingTsExtensions": true,
		"plugins": [
			{
				"name": "@astrojs/ts-plugin"
			}
		]
	},
	"exclude": [
		"components/*/dist"
	]
}
