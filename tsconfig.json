{
	"extends": "@hexadrop/tsconfig",
	"compilerOptions": {
		"emitDecoratorMetadata": false,
		"baseUrl": ".",
		"paths": {
			"@mariomh/cva": ["packages/cva/src/index.ts"],
			"@mariomh/badge/react": ["./components/badge/src/react.tsx"],
			"@mariomh/box/react": ["./components/box/src/react.tsx"],
			"@mariomh/button/react": ["./components/button/src/react.tsx"],
			"@mariomh/checkbox/react": ["./components/checkbox/src/react.tsx"],
			"@mariomh/copyright/react": ["./components/copyright/src/react.tsx"],
			"@mariomh/container/react": ["./components/container/src/react.tsx"],
			"@mariomh/focus/react": ["./components/focus/src/react.tsx"],
			"@mariomh/focus/variants": ["./components/focus/src/variants.ts"],
			"@mariomh/font/react": ["./components/font/src/react.tsx"],
			"@mariomh/font/variants": ["./components/font/src/variants.ts"],
			"@mariomh/heading/react": ["./components/heading/src/react.tsx"],
			"@mariomh/input/react": ["./components/input/src/react.tsx"],
			"@mariomh/round/react": ["./components/round/src/react.tsx"],
			"@mariomh/round/variants": ["./components/round/src/variants.ts"],
			"@mariomh/shadow/react": ["./components/shadow/src/react.tsx"],
			"@mariomh/span/react": ["./components/span/src/react.tsx"]
		},
		"allowImportingTsExtensions": true,
		"plugins": [
			{
				"name": "@astrojs/ts-plugin"
			}
		]
	},
	"exclude": [
		"components/*/dist"
	]
}
