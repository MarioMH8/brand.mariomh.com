{
	"name": "@mariomh8/root",
	"version": "0.0.1",
	"author": "MarioMH <dev@mariomh.com>",
	"description": "Sistema de diseño y guía de estilo de MarioMH",
	"keywords": [
		"design",
		"system",
		"style",
		"guide",
		"react",
		"astro",
		"tailwind",
		"components",
		"ui",
		"ux"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/MarioMH8/brand.mariomh.com.git"
	},
	"homepage": "https://brand.mariomh.com",
	"bugs": {
		"url": "https://github.com/MarioMH8/brand.mariomh.com/issues"
	},
	"license": "SEE LICENSE IN LICENSE",
	"private": true,
	"type": "module",
	"workspaces": [
		"components/*",
		"packages/*",
		"packages/fonts/*",
		"storybook"
	],
	"scripts": {
		"build": "bun run --filter '@mariomh8/*' build",
		"build:packages": "bun run --filter '@mariomh8/*' --filter '!@mariomh8/storybook' build",
		"build:storybook": "bun run --filter '@mariomh8/storybook' build",
		"check:packages": "bun run build && bun run lint:packages",
		"commitlint": "commitlint --edit",
		"lint": "eslint .",
		"lint:ci": "eslint --cache --cache-strategy content .",
		"lint:fix": "eslint --cache --fix .",
		"lint:packages": "bun run --filter '@mariomh8/*' lint:packages",
		"prepare": "husky",
		"test": "bun test",
		"typecheck": "tsc --noEmit",
		"typecheck:astro": "astro check"
	},
	"devDependencies": {
		"@astrojs/check": "0.9.12",
		"@changesets/cli": "3.0.3",
		"@commitlint/cli": "21.2.4",
		"@commitlint/config-conventional": "21.2.4",
		"@happy-dom/global-registrator": "21.0.4",
		"@hexadrop/eslint-config": "1.3.1",
		"@hexadrop/tsconfig": "0.0.5",
		"@types/bun": "1.4.4",
		"@types/react": "19.3.0",
		"eslint": "10.14.0",
		"husky": "9.1.7",
		"lint-staged": "17.6.0",
		"publint": "0.3.25",
		"typescript": "6.0.3"
	}
}
