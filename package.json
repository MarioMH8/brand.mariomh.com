{
	"name": "@mariomh/root",
	"version": "0.0.1",
	"author": "MarioMH <dev@mariomh.com>",
	"description": "Sistema de diseño y guía de estilo de MarioMH",
	"keywords": [
		"design",
		"system",
		"style",
		"guide",
		"react",
		"astro",
		"tailwind",
		"components",
		"ui",
		"ux"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/MarioMH8/brand.mariomh.com.git"
	},
	"homepage": "https://brand.mariomh.com",
	"bugs": {
		"url": "https://github.com/MarioMH8/brand.mariomh.com/issues"
	},
	"license": "PRIVATE",
	"private": true,
	"type": "module",
	"workspaces": [
		"components/*",
		"packages/*",
		"packages/fonts/*",
		"storybook"
	],
	"scripts": {
		"build": "bun run --filter '@mariomh/*' build",
		"build:storybook": "bun run --filter '@mariomh/storybook' build",
		"lint": "eslint .",
		"lint:fix": "eslint --fix .",
		"lint:packages": "bun run --filter '@mariomh/*' lint:packages",
		"test": "bun test",
		"typecheck": "tsc --noEmit",
		"typecheck:astro": "astro check"
	},
	"devDependencies": {
		"@astrojs/check": "0.9.4",
		"@changesets/cli": "2.28.1",
		"@happy-dom/global-registrator": "16.8.1",
		"@hexadrop/eslint-config": "0.1.0",
		"@hexadrop/tsconfig": "0.0.5",
		"@types/bun": "1.2.2",
		"@types/react": "19.0.10",
		"eslint": "9.20.1",
		"publint": "0.3.6",
		"typescript": "5.7.3"
	}
}
