{
	"name": "@mariomh/tailwind",
	"version": "0.0.2",
	"author": "MarioMH <dev@mariomh.com>",
	"description": "MarioMH tailwind plugin",
	"keywords": [
		"design",
		"system",
		"style",
		"guide",
		"react",
		"astro",
		"tailwind",
		"components",
		"ui",
		"ux"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/MarioMH8/brand.mariomh.com.git",
		"directory": "packages/tailwind"
	},
	"homepage": "https://brand.mariomh.com",
	"bugs": {
		"url": "https://github.com/MarioMH8/brand.mariomh.com/issues"
	},
	"license": "PRIVATE",
	"type": "module",
	"sideEffects": false,
	"main": "index.css",
	"exports": {
		".": {
			"default": "./index.css"
		},
		"./pallete": {
			"types": "./dist/pallete.d.ts",
			"default": "./dist/pallete.js"
		}
	},
	"typesVersions": {
		"*": {
			"./pallete": [
				"./dist/pallete.d.ts"
			]
		}
	},
	"scripts": {
		"build": "tsup",
		"lint:packages": "publint",
		"prepublishOnly": "tsup && publint"
	},
	"peerDependencies": {
		"tailwindcss": ">=4.0.0"
	},
	"devDependencies": {
		"tailwindcss": "4.1.13",
		"tsup": "8.5.0"
	}
}
