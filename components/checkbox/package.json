{
	"name": "@mariomh8/checkbox",
	"version": "0.3.1",
	"author": "MarioMH <dev@mariomh.com>",
	"description": "MarioMH checkbox",
	"keywords": [
		"design",
		"system",
		"style",
		"guide",
		"react",
		"astro",
		"tailwind",
		"components",
		"ui",
		"ux"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/MarioMH8/brand.mariomh.com.git",
		"directory": "components/checkbox"
	},
	"homepage": "https://brand.mariomh.com",
	"bugs": {
		"url": "https://github.com/MarioMH8/brand.mariomh.com/issues"
	},
	"license": "PRIVATE",
	"publishConfig": {
		"registry": "https://npm.pkg.github.com"
	},
	"type": "module",
	"sideEffects": false,
	"files": [
		"CHANGELOG.md",
		"dist"
	],
	"exports": {
		"./class-name": {
			"types": "./dist/class-name.d.mts",
			"default": "./dist/class-name.mjs"
		},
		"./package.json": {
			"default": "./package.json"
		},
		"./properties": {
			"types": "./dist/properties.d.mts",
			"default": "./dist/properties.mjs"
		},
		"./react": {
			"types": "./dist/react.d.mts",
			"default": "./dist/react.mjs"
		},
		"./variants": {
			"types": "./dist/variants.d.mts",
			"default": "./dist/variants.mjs"
		}
	},
	"scripts": {
		"build": "tsdown",
		"lint:packages": "publint"
	},
	"peerDependencies": {
		"@mariomh8/focus": ">=0.0.0 <1.0.0",
		"@mariomh8/round": ">=0.0.0 <1.0.0",
		"lucide-react": "^1",
		"radix-ui": "^1",
		"react": "^19",
		"react-dom": "^19"
	},
	"peerDependenciesMeta": {
		"@mariomh8/focus": {
			"optional": true
		},
		"@mariomh8/round": {
			"optional": true
		},
		"lucide-react": {
			"optional": true
		},
		"radix-ui": {
			"optional": true
		},
		"react": {
			"optional": true
		},
		"react-dom": {
			"optional": true
		}
	},
	"dependencies": {
		"@mariomh8/cva": "0.3.0"
	},
	"devDependencies": {
		"@mariomh8/focus": "0.2.1",
		"@mariomh8/round": "0.2.1",
		"@testing-library/react": "16.3.3",
		"lucide-react": "1.70.0",
		"radix-ui": "1.8.1",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"tsdown": "0.23.5"
	}
}
