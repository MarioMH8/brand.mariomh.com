---
import type { HTMLTag } from 'astro/types';

import type { AstroLabelProperties } from './astro';
import ELEMENT_TYPE from './element.ts';
import properties from './properties.ts';

export type Props<Tag extends HTMLTag> = AstroLabelProperties<Tag>;

const { as: Tag = ELEMENT_TYPE, ...p } = properties(Astro.props);
---

<Tag {...p}>
	<slot />
</Tag>
