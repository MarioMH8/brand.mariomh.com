{
	"name": "@mariomh8/badge",
	"version": "0.2.0",
	"author": "MarioMH <dev@mariomh.com>",
	"description": "MarioMH badge",
	"keywords": [
		"design",
		"system",
		"style",
		"guide",
		"react",
		"astro",
		"tailwind",
		"components",
		"ui",
		"ux"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/MarioMH8/brand.mariomh.com.git",
		"directory": "components/badge"
	},
	"homepage": "https://brand.mariomh.com",
	"bugs": {
		"url": "https://github.com/MarioMH8/brand.mariomh.com/issues"
	},
	"license": "PRIVATE",
	"publishConfig": {
		"registry": "https://npm.pkg.github.com"
	},
	"type": "module",
	"sideEffects": false,
	"files": [
		"dist"
	],
	"exports": {
		"./astro": {
			"types": "./dist/astro.ts",
			"default": "./dist/astro.ts"
		},
		"./class-name": {
			"types": "./dist/class-name.d.ts",
			"default": "./dist/class-name.js"
		},
		"./package.json": {
			"default": "./package.json"
		},
		"./properties": {
			"types": "./dist/properties.d.ts",
			"default": "./dist/properties.js"
		},
		"./react": {
			"types": "./dist/react.d.ts",
			"default": "./dist/react.js"
		},
		"./variants": {
			"types": "./dist/variants.d.ts",
			"default": "./dist/variants.js"
		}
	},
	"typesVersions": {
		"*": {
			"./astro": [
				"./dist/astro.ts"
			],
			"./class-name": [
				"./dist/class-name.d.ts"
			],
			"./properties": [
				"./dist/properties.d.ts"
			],
			"./react": [
				"./dist/react.d.ts"
			],
			"./variants": [
				"./dist/variants.d.ts"
			]
		}
	},
	"scripts": {
		"build": "tsup",
		"lint:packages": "publint"
	},
	"peerDependencies": {
		"@mariomh8/font": ">=0.0.0 <1.0.0",
		"@mariomh8/round": ">=0.0.0 <1.0.0",
		"astro": "^7",
		"radix-ui": "^1",
		"react": "^19"
	},
	"peerDependenciesMeta": {
		"@mariomh8/font": {
			"optional": true
		},
		"@mariomh8/round": {
			"optional": true
		},
		"astro": {
			"optional": true
		},
		"radix-ui": {
			"optional": true
		},
		"react": {
			"optional": true
		}
	},
	"dependencies": {
		"@mariomh8/cva": "0.1.1"
	},
	"devDependencies": {
		"@mariomh8/font": "0.1.1",
		"@mariomh8/round": "0.1.1",
		"@testing-library/react": "16.3.3",
		"astro": "7.4.8",
		"radix-ui": "1.8.1",
		"react": "19.3.1",
		"tsup": "9.0.0"
	}
}
