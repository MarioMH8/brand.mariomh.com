---
import type { HTMLTag } from 'astro/types';

import type { AstroHeadingProperties } from './astro';
import ELEMENT_TYPE from './element.ts';
import properties from './properties.ts';

export type Props<Tag extends HTMLTag> = AstroHeadingProperties<Tag>;

const { as, heading, ...p } = properties(Astro.props);

const Tag = as ?? heading ?? ELEMENT_TYPE;
---

<Tag {...p}>
	<slot />
</Tag>
