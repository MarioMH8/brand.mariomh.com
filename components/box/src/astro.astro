---
import type { HTMLTag } from 'astro/types';

import type { AstroBoxProperties } from './astro';
import ELEMENT_TYPE from './element';
import properties from './properties';

type Props<Tag extends HTMLTag> = AstroBoxProperties<Tag>;

const { as: Tag = ELEMENT_TYPE, ...p } = properties(Astro.props);
---

<Tag {...p}>
	<slot />
</Tag>
