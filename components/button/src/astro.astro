---
import type { HTMLTag } from 'astro/types';

import type { AstroButtonProperties } from './astro';
import ELEMENT_TYPE from './element';
import properties from './properties';

type Props<Tag extends HTMLTag = typeof ELEMENT_TYPE> = AstroButtonProperties<Tag>;

const { as: Tag = ELEMENT_TYPE, ...p } = properties(Astro.props as Props);
---

<Tag {...p}>
	<slot />
</Tag>
