{
	"name": "@mariomh/focus",
	"version": "0.0.10",
	"author": "MarioMH <dev@mariomh.com>",
	"description": "MarioMH focus",
	"keywords": [
		"design",
		"system",
		"style",
		"guide",
		"react",
		"astro",
		"tailwind",
		"components",
		"ui",
		"ux"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/MarioMH8/brand.mariomh.com.git",
		"directory": "components/focus"
	},
	"homepage": "https://brand.mariomh.com",
	"bugs": {
		"url": "https://github.com/MarioMH8/brand.mariomh.com/issues"
	},
	"license": "PRIVATE",
	"type": "module",
	"sideEffects": false,
	"files": [
		"dist"
	],
	"exports": {
		"./class-name": {
			"types": "./dist/class-name.d.ts",
			"default": "./dist/class-name.js"
		},
		"./package.json": {
			"default": "./package.json"
		},
		"./react": {
			"types": "./dist/react.d.ts",
			"default": "./dist/react.js"
		},
		"./variants": {
			"types": "./dist/variants.d.ts",
			"default": "./dist/variants.js"
		}
	},
	"typesVersions": {
		"*": {
			"./class-name": [
				"./dist/class-name.d.ts"
			],
			"./react": [
				"./dist/react.d.ts"
			],
			"./variants": [
				"./dist/variants.d.ts"
			]
		}
	},
	"scripts": {
		"build": "tsup",
		"lint:packages": "publint",
		"prepublishOnly": "tsup && publint"
	},
	"peerDependencies": {
		"radix-ui": "^1",
		"react": "^19"
	},
	"peerDependenciesMeta": {
		"radix-ui": {
			"optional": true
		},
		"react": {
			"optional": true
		}
	},
	"dependencies": {
		"@mariomh/cva": "0.0.8"
	},
	"devDependencies": {
		"@testing-library/react": "16.3.1",
		"radix-ui": "1.4.3",
		"react": "19.2.3",
		"tsup": "8.5.1"
	}
}
