	"type": "module",
	"sideEffects": false,
	"files": [
		"dist"
	],
	"exports": {
		"./astro": {
			"types": "./dist/astro/index.ts",
			"default": "./dist/astro/index.ts"
		},
		"./class-name": {
			"types": "./dist/class-name/index.d.ts",
			"default": "./dist/class-name/index.js"
		},
		"./package.json": {
			"default": "./package.json"
		},
		"./properties": {
			"types": "./dist/properties/index.d.ts",
			"default": "./dist/properties/index.js"
		},
		"./react": {
			"types": "./dist/react/index.d.ts",
			"default": "./dist/react/index.js"
		},
		"./variants": {
			"types": "./dist/variants/index.d.ts",
			"default": "./dist/variants/index.js"
		}
	},
	"typesVersions": {
		"*": {
			"./astro": [
				"./dist/astro/index.ts"
			],
			"./class-name": [
				"./dist/class-name/index.d.ts"
			],
			"./properties": [
				"./dist/properties/index.d.ts"
			],
			"./react": [
				"./dist/react/index.d.ts"
			],
			"./variants": [
				"./dist/variants/index.d.ts"
			]
		}
	},
	"scripts": {
		"build": "tsup",
		"lint:packages": "publint",
		"prepublishOnly": "tsup && publint"
	},
	"peerDependencies": {
		"@mariomh/button": "0.0.11",
		"@mariomh/container": "0.0.10",
		"@mariomh/font": "0.0.8",
		"@mariomh/logo": "0.0.10",
		"astro": "^5",
		"lucide-astro": "^0",
		"lucide-react": "^0",
		"radix-ui": "^1",
		"react": "^19"
	},
	"peerDependenciesMeta": {
		"@mariomh/button": {
			"optional": true
		},
		"@mariomh/container": {
			"optional": true
		},
		"@mariomh/font": {
			"optional": true
		},
		"@mariomh/logo": {
			"optional": true
		},
		"astro": {
			"optional": true
		},
		"lucide-astro": {
			"optional": true
		},
