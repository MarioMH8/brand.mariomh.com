	],
	"exports": {
		"./astro": {
			"types": "./dist/astro/index.ts",
			"default": "./dist/astro/index.ts"
		},
		"./class-name": {
			"types": "./dist/class-name/index.d.mts",
			"default": "./dist/class-name/index.mjs"
		},
		"./package.json": {
			"default": "./package.json"
		},
		"./properties": {
			"types": "./dist/properties/index.d.mts",
			"default": "./dist/properties/index.mjs"
		},
		"./react": {
			"types": "./dist/react/index.d.mts",
			"default": "./dist/react/index.mjs"
		},
		"./variants": {
			"types": "./dist/variants/index.d.mts",
			"default": "./dist/variants/index.mjs"
		}
	},
	"scripts": {
		"build": "tsdown",
		"lint:packages": "publint"
	},
	"peerDependencies": {
		"@mariomh8/button": ">=0.0.0 <1.0.0",
		"@mariomh8/container": ">=0.0.0 <1.0.0",
