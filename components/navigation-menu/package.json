			"optional": true
		},
		"radix-ui": {
			"optional": true
		},
		"react": {
			"optional": true
		}
	},
	"dependencies": {
		"@mariomh/cva": "0.0.7"
	},
	"devDependencies": {
		"@mariomh/button": "0.0.11",
		"@mariomh/container": "0.0.10",
		"@mariomh/font": "0.0.8",
		"@mariomh/logo": "0.0.10",
		"@testing-library/react": "16.3.0",
		"astro": "5.16.1",
		"lucide-astro": "0.555.0",
		"lucide-react": "0.555.0",
		"radix-ui": "1.4.3",
