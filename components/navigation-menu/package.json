		},
		"@mariomh8/logo": {
			"optional": true
		},
		"astro": {
			"optional": true
		},
		"lucide-astro": {
			"optional": true
		},
		"lucide-react": {
			"optional": true
		},
		"radix-ui": {
			"optional": true
		},
		"react": {
			"optional": true
		}
	},
