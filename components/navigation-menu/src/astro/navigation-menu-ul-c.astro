---
import type { HTMLTag } from 'astro/types';

import { NAVIGATION_MENU_UL_ELEMENT } from '../element/index.ts';
import { propertiesNavigationMenuUL } from '../properties/index.ts';
import type { AstroNavigationMenuULProperties } from './navigation-menu-ul.astro.ts';

export type Props<Tag extends HTMLTag> = AstroNavigationMenuULProperties<Tag>;
const { as: Tag = NAVIGATION_MENU_UL_ELEMENT, ...p } = propertiesNavigationMenuUL(Astro.props);
---

