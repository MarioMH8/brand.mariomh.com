{
	"name": "@mariomh/textarea",
	"version": "0.0.4",
	"author": "MarioMH <dev@mariomh.com>",
	"description": "MarioMH textarea",
	"keywords": [
		"design",
		"system",
		"style",
		"guide",
		"react",
		"astro",
		"tailwind",
		"components",
		"ui",
		"ux"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/MarioMH8/brand.mariomh.com.git",
		"directory": "components/textarea"
	},
	"homepage": "https://brand.mariomh.com",
	"bugs": {
		"url": "https://github.com/MarioMH8/brand.mariomh.com/issues"
	},
	"license": "PRIVATE",
	"type": "module",
	"sideEffects": false,
	"files": [
		"dist"
	],
	"exports": {
		"./astro": {
			"types": "./dist/astro.ts",
			"default": "./dist/astro.ts"
		},
		"./class-name": {
			"types": "./dist/class-name.d.ts",
			"default": "./dist/class-name.js"
		},
		"./package.json": {
			"default": "./package.json"
		},
		"./properties": {
			"types": "./dist/properties.d.ts",
			"default": "./dist/properties.js"
		},
		"./react": {
			"types": "./dist/react.d.ts",
			"default": "./dist/react.js"
		},
		"./variants": {
			"types": "./dist/variants.d.ts",
			"default": "./dist/variants.js"
		}
	},
	"typesVersions": {
		"*": {
			"./astro": [
				"./dist/astro.ts"
			],
			"./class-name": [
				"./dist/class-name.d.ts"
			],
			"./properties": [
				"./dist/properties.d.ts"
			],
			"./react": [
				"./dist/react.d.ts"
			],
			"./variants": [
				"./dist/variants.d.ts"
			]
		}
	},
	"scripts": {
		"build": "tsup",
		"lint:packages": "publint",
		"prepublishOnly": "tsup && publint"
	},
	"peerDependencies": {
		"@mariomh/focus": "0.0.3",
		"@mariomh/font": "0.0.3",
		"@mariomh/round": "0.0.3",
		"astro": "^5",
		"radix-ui": "^1",
		"react": "^19"
	},
	"peerDependenciesMeta": {
		"@mariomh/focus": {
			"optional": true
		},
		"@mariomh/font": {
			"optional": true
		},
		"@mariomh/round": {
			"optional": true
		},
		"astro": {
			"optional": true
		},
		"radix-ui": {
			"optional": true
		},
		"react": {
			"optional": true
		}
	},
	"dependencies": {
		"@mariomh/cva": "0.0.3"
	},
	"devDependencies": {
		"@mariomh/focus": "0.0.3",
		"@mariomh/font": "0.0.3",
		"@mariomh/round": "0.0.3",
		"@testing-library/react": "16.3.0",
		"astro": "5.7.13",
		"radix-ui": "1.3.4",
		"react": "19.1.0",
		"tsup": "8.5.0"
	}
}
